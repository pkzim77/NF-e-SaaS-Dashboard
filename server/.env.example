# Copie para `.env` e preencha. O `.env` real NÃO vai para o git.
DATABASE_URL="file:./dev.db"
PORT=4000

# ── Integração SEFAZ ───────────────────────────────────────────────
# Ambiente: 2 = homologação (testes), 1 = produção (notas reais)
SEFAZ_TP_AMB=2

# Certificado digital A1 (.pfx). Caminho fora do repositório!
# Ex.: C:/certificados/empresa.pfx  (use barras normais "/")
CERT_PATH=
CERT_PASSWORD=
